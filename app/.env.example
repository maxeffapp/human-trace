# Server-side only. Never exposed to the browser bundle. Never committed.
OPENAI_API_KEY=

# Optional. Leave unset for OpenAI.
# For an OpenAI-compatible gateway, set the full base path, e.g.:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Read docs/providers.md first — hosted web search differs between providers.
OPENAI_BASE_URL=

# Optional. Defaults to gpt-5.5. Gateways use their own model slugs,
# e.g. openai/gpt-5.2 on OpenRouter.
OPENAI_MODEL=

# Set to 1 to enable the local visual-QA fixture. Production answers are never prewritten.
HUMAN_TRACE_PREVIEW=
